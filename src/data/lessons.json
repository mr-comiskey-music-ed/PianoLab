{
  "lessons": [
    {
      "id": "lesson-1",
      "number": 1,
      "title": "White-key note names",
      "learn": [
        {
          "id": "fc-intro",
          "section": "Find F and C",
          "title": "Look at the black keys",
          "say": "Black keys come in groups of 2 and groups of 3. Those groups are your map. C sits just LEFT of the group of 2. F sits just LEFT of the group of 3.",
          "demo": [
            "C3",
            "F3",
            "C4",
            "F4"
          ],
          "tryText": "Find a C. Play any C.",
          "tryAnswer": [
            "C"
          ],
          "need": 2,
          "hint": "Look for a group of 2 black keys. C is the white key just to its left."
        },
        {
          "id": "fc-f",
          "section": "Find F and C",
          "title": "Now F",
          "say": "F is just left of the group of 3 black keys.",
          "demo": [
            "F3",
            "F4"
          ],
          "tryText": "Play any F.",
          "tryAnswer": [
            "F"
          ],
          "need": 2,
          "hint": "Find a group of 3 black keys. F is the white key just to its left."
        },
        {
          "id": "alpha-up",
          "section": "The musical alphabet",
          "title": "Going up",
          "say": "Music uses only 7 letters: A B C D E F G. Moving to the RIGHT, the letters go up in order.",
          "tryText": "Play any E.",
          "tryAnswer": [
            "E"
          ],
          "need": 2,
          "hint": "Start at C, then count right: C, D, E."
        },
        {
          "id": "alpha-down",
          "section": "The musical alphabet",
          "title": "Going down",
          "say": "Moving to the LEFT, the letters go backward: G F E D C B A.",
          "tryText": "Play any B.",
          "tryAnswer": [
            "B"
          ],
          "need": 2,
          "hint": "B is the white key just to the left of C."
        },
        {
          "id": "alpha-wrap",
          "section": "The musical alphabet",
          "title": "G wraps back to A",
          "say": "After G, the alphabet starts over at A. The keys repeat, so the same letters show up again higher up.",
          "demo": [
            "F4",
            "G4",
            "A4",
            "B4"
          ],
          "tryText": "Play any A.",
          "tryAnswer": [
            "A"
          ],
          "need": 2,
          "hint": "A is the white key just right of G. Look between the 2-group and the 3-group of black keys."
        },
        {
          "id": "all-white",
          "section": "Every white key",
          "title": "All seven names",
          "say": "Every white key has one of those seven names. The pattern of black keys repeats, so the names repeat too.",
          "tryText": "Play any D.",
          "tryAnswer": [
            "D"
          ],
          "need": 2,
          "hint": "D sits between the two black keys of the group of 2."
        },
        {
          "id": "all-white-2",
          "section": "Every white key",
          "title": "One more",
          "say": "Use the map: groups of 2 and 3 tell you where you are.",
          "tryText": "Play any G.",
          "tryAnswer": [
            "G"
          ],
          "need": 2,
          "hint": "Count from F: F, then G is the next white key to the right."
        }
      ],
